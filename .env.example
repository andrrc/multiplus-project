# Copie este arquivo para .env (dev) ou configure estas variáveis diretamente no
# ambiente de produção (VPS Contabo). Nunca commite o .env real.

# --- Banco de dados (Postgres, self-hosted via Docker Compose) ---
POSTGRES_USER=multiplus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=multiplus
# Em dev, o Postgres roda via docker-compose com a porta publicada em 5434 no host
# (evita colidir com outros Postgres locais, ex. Supabase CLI em 5432/5433).
DATABASE_URL="postgresql://multiplus:troque-esta-senha@localhost:5434/multiplus?schema=public"

# Role de aplicação restrita usada em runtime (não-superuser) para respeitar RLS.
# Criada pela migration de RLS (ver prisma/migrations/*_rls_policies).
APP_DATABASE_URL="postgresql://multiplus_app:troque-esta-senha-app@localhost:5434/multiplus?schema=public"

# Banco separado para os testes de integração (tests/integration/) — nunca aponta pro
# banco de dev, pra não misturar fixture de teste com dado real. Ver tests/integration/setup/.
TEST_DATABASE_URL="postgresql://multiplus:troque-esta-senha@localhost:5434/multiplus_test?schema=public"
TEST_APP_DATABASE_URL="postgresql://multiplus_app:troque-esta-senha-app@localhost:5434/multiplus_test?schema=public"

# --- Auth.js ---
# Gerar com: npx auth secret  (ou: openssl rand -base64 33)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- MinIO (S3-compatible, storage de imagens de comentários — RF-017) ---
MINIO_ROOT_USER=multiplus
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=multiplus-uploads

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Múltiplus <nao-responda@multiplus.com.br>"

# --- Consulta de CNPJ (ex.: BrasilAPI) ---
CNPJ_API_BASE_URL=https://brasilapi.com.br/api/cnpj/v1

# --- Domínio (produção, usado pelo Caddy para SSL automático) ---
APP_DOMAIN=app.multiplusambiental.com.br
