// Modelo de dados — ver docs/architecture-multiplus-software.md, Seção 3.1 (ER) e 3.2 (RLS)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN // Talita — acesso total
  ADMIN_INTERNO // atribuído por PROJETO
  ADMIN_EXTERNO // atribuído por TAREFA
  CLIENTE // vinculado a um Cliente, somente leitura
}

enum EntidadeTipo {
  PROJETO
  TAREFA
}

enum TipoToken {
  DEFINIR_SENHA // RF-030 / RF-031 — primeiro acesso
  RECUPERAR_SENHA // RF-032 — esqueci minha senha
}

enum TipoCliente {
  PESSOA_FISICA // RF-035
  PESSOA_JURIDICA // RF-001, default de migration pros clientes da Sprint 2 (ADR-006)
}

enum TipoPessoaEnvolvida {
  PESSOA // nome, CPF (opcional), telefone, e-mail
  EMPRESA // razão social (reaproveita a coluna `nome`), CNPJ (opcional), telefone, e-mail
}

enum StatusProjeto {
  A_INICIAR    @map("A iniciar")
  EM_ANDAMENTO @map("Em andamento")
  CONCLUIDO    @map("Concluído")
  CANCELADO    @map("Cancelado")
}

enum StatusTarefa {
  A_INICIAR                    @map("A iniciar")
  EM_ANDAMENTO                 @map("Em andamento")
  AGUARDANDO_DOCUMENTO_CLIENTE @map("Aguardando documento do cliente")
  VISITA_REUNIAO_AGENDADA      @map("Visita/reunião agendada")
  PROTOCOLADO                  @map("Protocolado")
  SOB_ANALISE_ORGAO_AMBIENTAL  @map("Sob análise do órgão ambiental")
  COM_EXIGENCIA_A_CUMPRIR      @map("Com exigência a cumprir")
  CONCLUIDO                    @map("Concluído")
  CANCELADO                    @map("Cancelado")
}

enum Periodicidade {
  SEMANAL
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

model Usuario {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  senhaHash String? // null até o usuário definir a senha via link de onboarding (RF-030/031)
  perfil    Perfil  @default(CLIENTE)
  ativo     Boolean @default(true)

  /// RF-030/RF-040 — dados de cadastro, todos opcionais (mesmo princípio do RF-002d no
  /// Cadastro de Clientes: em branco vira NULL, com validação de formato só quando
  /// preenchido). Não travam a criação de um acesso urgente.
  ///
  /// `cpf` e `cnpj` seguem o par PF/PJ já usado em `Cliente` (ADR-006) e
  /// `PessoaEnvolvida` (ADR-007), mas **sem** coluna discriminadora: qual dos dois vale
  /// é dado por qual está preenchido, e o formulário detecta isso ao editar — mesmo
  /// padrão de `ehSegmentoCustomizado` na Sprint 2. Uma coluna `tipo` aqui seria um
  /// terceiro registro da mesma informação, com chance de discordar dos outros dois.
  ///
  /// Sem `@unique` em cpf/cnpj de propósito: quem identifica o usuário é o e-mail, que já
  /// é único. Um unique aqui transformaria um documento repetido — que acontece, por
  /// exemplo, com MEI cadastrado como pessoa e como empresa — em erro de banco.
  cargo       String?
  telefone    String?
  cpf         String?
  cnpj        String?
  observacoes String?

  /// RF-039/ADR-008 — auditoria da desativação. `ativo` já existia desde a Sprint 1 com a
  /// semântica do RF-029 (bloquear acesso do cliente): é a mesma operação, então é
  /// reaproveitada aqui em vez de uma coluna paralela. O status de acesso da Tela A1 (Ativo /
  /// Pendente de ativação / Desativado) é derivado de `ativo` + `senhaHash`, não persistido.
  desativadoEm  DateTime?
  desativadoPor String?

  // Preenchido apenas para perfil CLIENTE — vincula o usuário à empresa que ele representa.
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// ADR-005/ADR-007 — vincula o Usuario Colaborador Externo à Pessoa Envolvida de origem
  /// (RF-028/RF-033), quando houver. Cópia de dados só na criação, sem sincronização ao vivo.
  pessoaEnvolvidaId String?          @unique
  pessoaEnvolvida   PessoaEnvolvida? @relation(fields: [pessoaEnvolvidaId], references: [id])

  atribuicoes  Atribuicao[]
  comentarios  Comentario[]
  tokensAcesso TokenAcesso[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@map("usuarios")
}

/// ADR-006 — tabela única para PF e PJ, discriminada por `tipo`. Colunas específicas de um
/// tipo ficam nullable; a validação de "campo certo pro tipo certo" é responsabilidade da
/// aplicação (src/lib/clientes.ts), não do banco.
model Cliente {
  id   String      @id @default(cuid())
  tipo TipoCliente @default(PESSOA_JURIDICA)

  /// PJ: razão social. PF: nome da pessoa (RF-035) — mesmo campo, reaproveitado para não
  /// exigir uma coluna `nome` paralela (menor custo de retrofit, ADR-006).
  razaoSocial String

  cnpj String? @unique // obrigatório só para PESSOA_JURIDICA
  cpf  String? @unique // obrigatório só para PESSOA_FISICA
  rg   String? // PESSOA_FISICA

  endereco  String?
  cep       String? // PESSOA_FISICA (RF-035)
  municipio String? // PF e PJ (RF-002c) — selecionado via API do IBGE, adicional a `endereco`
  estado    String? // PF e PJ (RF-002c) — sigla UF, filtra as opções de `municipio`

  atividadePrincipal String? // RF-002a — texto livre, PF e PJ
  porte              String? // RF-002b — lista fixa, só PESSOA_JURIDICA

  /// PESSOA_FISICA: necessário pra RF-031 (acesso criado direto pra própria pessoa, sem
  /// Ponto de Contato intermediário) — RF-035 não lista o campo explicitamente, mas RF-031
  /// não funciona sem ele. PESSOA_JURIDICA não usa (usa o e-mail do Ponto de Contato).
  email String?

  segmento      String
  origemContato String

  /// RF-039/ADR-008 — desativação (soft delete). `desativadoPor` guarda o id do Usuario sem
  /// FK nativa, mesmo princípio do ADR-004: é campo de auditoria, e quatro relações reversas
  /// só pra isso poluiriam o model Usuario sem nenhum ganho real de integridade.
  ativo         Boolean   @default(true)
  desativadoEm  DateTime?
  desativadoPor String?

  usuarios          Usuario[]
  projetos          Projeto[]
  responsavelLegal  ResponsavelLegal?
  pontoContato      PontoContato?
  pessoasEnvolvidas PessoaEnvolvida[]
  documentos        Documento[]
  comentarios       Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@map("clientes")
}

/// RF-026 — dados do Responsável Legal da empresa. Telefone é campo sensível
/// (RF-020): mascarado para ADMIN_INTERNO/EXTERNO via a view `ResponsavelLegalSeguro`,
/// nunca lido diretamente por código de leitura/exibição.
model ResponsavelLegal {
  id        String  @id @default(cuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// RF-002d — a seção inteira é opcional; só validação de formato quando preenchido.
  nome     String?
  endereco String?
  rg       String?
  cpf      String?
  telefone String?
  email    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("responsaveis_legais")
}

/// RF-027 — Ponto de Contato, pode ter dados herdados do Responsável Legal no
/// momento do cadastro (decidido na camada de aplicação, não persistido aqui).
/// Mesmo cuidado de RF-020 com `telefone` do ResponsavelLegal acima.
model PontoContato {
  id        String  @id @default(cuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// RF-002d — a seção inteira é opcional, `cargo` inclusive mesmo quando herdado.
  nome     String?
  endereco String?
  rg       String?
  cpf      String?
  telefone String?
  email    String?
  cargo    String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pontos_contato")
}

/// RF-028/ADR-007 — Pessoas Envolvidas com o cliente (renomeada de "Pessoas do Operacional"),
/// cadastro opcional e múltiplo, PF e PJ. `tipo` determina os campos exibidos no formulário
/// (Pessoa: nome+CPF; Empresa: razão social, reaproveitando `nome`, +CNPJ). `temAcesso`
/// controla se existe um `Usuario` Colaborador Externo vinculado (RF-028/RF-033).
model PessoaEnvolvida {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo      TipoPessoaEnvolvida @default(PESSOA)
  nome      String // Pessoa: nome. Empresa/PJ envolvida: razão social (ADR-006, mesmo padrão de reaproveitamento de coluna).
  cpf       String? // só tipo PESSOA
  cnpj      String? // só tipo EMPRESA
  telefone  String?
  email     String?
  temAcesso Boolean             @default(false)

  /// Legado da Sprint 2 (PessoaOperacional) — não faz parte do formulário novo, mantido só
  /// para não perder dado de cadastros já existentes.
  cargo String?

  /// RF-039/ADR-008 — desativação (soft delete). Ver comentário em `Cliente`.
  ativo         Boolean   @default(true)
  desativadoEm  DateTime?
  desativadoPor String?

  usuario              Usuario?
  tarefasResponsavel   Tarefa[]    @relation("TarefaResponsavel")
  subtarefasAtribuidas Subtarefa[] @relation("SubtarefaAtribuidoA")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@map("pessoas_envolvidas")
}

/// RF-013 — link de documento do Google Drive vinculado ao cliente (sem upload
/// de arquivo). Vínculo a projeto fica para o módulo de Projetos/Tarefas.
model Documento {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  projetoId String?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  nome String
  link String

  /// RF-039/ADR-008 — desativação (soft delete). Ver comentário em `Cliente`.
  ativo         Boolean   @default(true)
  desativadoEm  DateTime?
  desativadoPor String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@index([projetoId])
  @@map("documentos")
}

/// RF-020 — leitura segura do Responsável Legal: `telefone` só vem preenchido
/// quando app_current_perfil() = 'ADMIN' (ver migration de RLS/views). Nunca usar
/// o model `ResponsavelLegal` acima para exibir dados — só para escrita.
view ResponsavelLegalSeguro {
  id        String  @unique
  clienteId String  @unique
  nome      String?
  endereco  String?
  rg        String?
  cpf       String?
  telefone  String?
  email     String?

  criadoEm     DateTime
  atualizadoEm DateTime

  @@map("responsaveis_legais_seguro")
}

/// RF-020 — leitura segura do Ponto de Contato, mesmo princípio da view acima.
view PontoContatoSeguro {
  id        String  @unique
  clienteId String  @unique
  nome      String?
  endereco  String?
  rg        String?
  cpf       String?
  telefone  String?
  email     String?
  cargo     String?

  criadoEm     DateTime
  atualizadoEm DateTime

  @@map("pontos_contato_seguro")
}

/// RF-004/RF-038 — projeto e seus prazos gerenciais. `ativo` e os campos de auditoria
/// sustentam o soft delete por herança do RF-039/ADR-008.
model Projeto {
  id                    String        @id @default(cuid())
  clienteId             String
  cliente               Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome                  String
  descricao             String?
  dataInicio            DateTime?
  dataPrevistaConclusao DateTime?
  status                StatusProjeto @default(A_INICIAR)
  ativo                 Boolean       @default(true)
  desativadoEm          DateTime?
  desativadoPor         String?

  tarefas     Tarefa[]
  documentos  Documento[]
  comentarios Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@map("projetos")
}

model Tarefa {
  id               String         @id @default(cuid())
  projetoId        String
  projeto          Projeto        @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome             String
  descricao        String?
  prazo            DateTime?
  status           StatusTarefa   @default(A_INICIAR)
  periodicidade    Periodicidade?
  serieId          String?
  prazoOriginal    DateTime?
  serieEncerradaEm DateTime?
  diasAntecedencia Int?
  ativo            Boolean        @default(true)
  desativadoEm     DateTime?
  desativadoPor    String?

  /// RF-005/RN-006 — qualquer Pessoa Envolvida, com ou sem acesso ao sistema. Quando tem
  /// acesso (`temAcesso = true`), definir o responsável cria automaticamente o registro
  /// correspondente em Atribuicao (ver src/lib/tarefas.ts#definirResponsavelTarefa).
  responsavelId String?
  responsavel   PessoaEnvolvida? @relation("TarefaResponsavel", fields: [responsavelId], references: [id])

  subtarefas  Subtarefa[]
  comentarios Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@index([serieId])
  @@map("tarefas")
}

model Subtarefa {
  id            String    @id @default(cuid())
  tarefaId      String
  tarefa        Tarefa    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  titulo        String
  etiquetas     String[]  @default([])
  concluida     Boolean   @default(false)
  ativo         Boolean   @default(true)
  desativadoEm  DateTime?
  desativadoPor String?

  // RF-021 / RN-004 — só esta Pessoa Envolvida (ou o ADMIN) pode marcar como concluída.
  // Migrada de FK Usuario pra FK PessoaEnvolvida no ADR-007 — RLS/trigger agora resolvem
  // via Usuario.pessoaEnvolvidaId (reverso) pra comparar com este campo.
  atribuidoAId String?
  atribuidoA   PessoaEnvolvida? @relation("SubtarefaAtribuidoA", fields: [atribuidoAId], references: [id])
  comentarios  Comentario[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
  @@map("subtarefas")
}

/// RF-016/RF-047 — comentário imutável, ligado a exatamente um nível da hierarquia.
model Comentario {
  id          String     @id @default(cuid())
  texto       String
  link        String?
  imagemChave String?
  autorId     String
  autor       Usuario    @relation(fields: [autorId], references: [id], onDelete: Cascade)
  projetoId   String?
  projeto     Projeto?   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  tarefaId    String?
  tarefa      Tarefa?    @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  subtarefaId String?
  subtarefa   Subtarefa? @relation(fields: [subtarefaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime   @default(now())
  cliente     Cliente?   @relation(fields: [clienteId], references: [id])
  clienteId   String?

  @@index([projetoId, criadoEm])
  @@index([tarefaId, criadoEm])
  @@index([subtarefaId, criadoEm])
  @@map("comentarios")
}

/// Tabela polimórfica (ADR-004): registra que `usuario` tem acesso a `entidadeId`,
/// que é um Projeto ou uma Tarefa conforme `entidadeTipo`. Sem FK nativa para
/// entidadeId — validação de integridade fica na camada de aplicação.
model Atribuicao {
  id           String       @id @default(cuid())
  usuarioId    String
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entidadeTipo EntidadeTipo
  entidadeId   String

  criadoEm DateTime @default(now())

  @@unique([usuarioId, entidadeTipo, entidadeId])
  @@index([entidadeTipo, entidadeId])
  @@map("atribuicoes")
}

/// Token de uso único para definição de senha (primeiro acesso) e recuperação de
/// senha (RF-030 a RF-032). O e-mail carrega apenas o token em texto puro; só o
/// hash fica no banco.
model TokenAcesso {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  tipo      TipoToken
  expiraEm  DateTime
  usadoEm   DateTime?

  criadoEm DateTime @default(now())

  @@map("tokens_acesso")
}
