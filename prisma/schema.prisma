// Modelo de dados — ver docs/architecture-multiplus-software.md, Seção 3.1 (ER) e 3.2 (RLS)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN // Talita — acesso total
  ADMIN_INTERNO // atribuído por PROJETO
  ADMIN_EXTERNO // atribuído por TAREFA
  CLIENTE // vinculado a um Cliente, somente leitura
}

enum EntidadeTipo {
  PROJETO
  TAREFA
}

enum TipoToken {
  DEFINIR_SENHA // RF-030 / RF-031 — primeiro acesso
  RECUPERAR_SENHA // RF-032 — esqueci minha senha
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String? // null até o usuário definir a senha via link de onboarding (RF-030/031)
  perfil    Perfil   @default(CLIENTE)
  ativo     Boolean  @default(true)

  // Preenchido apenas para perfil CLIENTE — vincula o usuário à empresa que ele representa.
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  atribuicoes           Atribuicao[]
  subtarefasAtribuidas  Subtarefa[]  @relation("SubtarefaAtribuidoA")
  tokensAcesso          TokenAcesso[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("usuarios")
}

model Cliente {
  id            String  @id @default(cuid())
  razaoSocial   String
  cnpj          String  @unique
  endereco      String?
  segmento      String
  origemContato String

  usuarios           Usuario[]
  projetos           Projeto[]
  responsavelLegal   ResponsavelLegal?
  pontoContato       PontoContato?
  pessoasOperacional PessoaOperacional[]
  documentos         Documento[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("clientes")
}

/// RF-026 — dados do Responsável Legal da empresa. Telefone é campo sensível
/// (RF-020): mascarado para ADMIN_INTERNO/EXTERNO via a view `ResponsavelLegalSeguro`,
/// nunca lido diretamente por código de leitura/exibição.
model ResponsavelLegal {
  id        String  @id @default(cuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome     String
  endereco String
  rg       String
  cpf      String
  telefone String
  email    String

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("responsaveis_legais")
}

/// RF-027 — Ponto de Contato, pode ter dados herdados do Responsável Legal no
/// momento do cadastro (decidido na camada de aplicação, não persistido aqui).
/// Mesmo cuidado de RF-020 com `telefone` do ResponsavelLegal acima.
model PontoContato {
  id        String  @id @default(cuid())
  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome     String
  endereco String
  rg       String
  cpf      String
  telefone String
  email    String
  cargo    String

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pontos_contato")
}

/// RF-028 — pessoas do time operacional do cliente, cadastro opcional e múltiplo.
model PessoaOperacional {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome  String
  cargo String
  email String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pessoas_operacional")
}

/// RF-013 — link de documento do Google Drive vinculado ao cliente (sem upload
/// de arquivo). Vínculo a projeto fica para o módulo de Projetos/Tarefas.
model Documento {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome String
  link String

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("documentos")
}

/// RF-020 — leitura segura do Responsável Legal: `telefone` só vem preenchido
/// quando app_current_perfil() = 'ADMIN' (ver migration de RLS/views). Nunca usar
/// o model `ResponsavelLegal` acima para exibir dados — só para escrita.
view ResponsavelLegalSeguro {
  id        String  @unique
  clienteId String  @unique
  nome      String
  endereco  String
  rg        String
  cpf       String
  telefone  String?
  email     String

  criadoEm    DateTime
  atualizadoEm DateTime

  @@map("responsaveis_legais_seguro")
}

/// RF-020 — leitura segura do Ponto de Contato, mesmo princípio da view acima.
view PontoContatoSeguro {
  id        String  @unique
  clienteId String  @unique
  nome      String
  endereco  String
  rg        String
  cpf       String
  telefone  String?
  email     String
  cargo     String

  criadoEm    DateTime
  atualizadoEm DateTime

  @@map("pontos_contato_seguro")
}

/// Escopo mínimo (id, cliente, status) para sustentar Atribuicao e RLS nesta sprint.
/// Campos completos (prazos, licenças etc.) entram no módulo de Projetos/Tarefas.
model Projeto {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  status    String  @default("ativo")

  tarefas Tarefa[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("projetos")
}

model Tarefa {
  id        String  @id @default(cuid())
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome      String
  status    String  @default("pendente")

  subtarefas Subtarefa[]

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("tarefas")
}

model Subtarefa {
  id        String  @id @default(cuid())
  tarefaId  String
  tarefa    Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  etiqueta  String
  concluida Boolean @default(false)

  // RF-021 / RN-004 — só esta pessoa (ou o ADMIN) pode marcar como concluída.
  atribuidoAId String?
  atribuidoA   Usuario? @relation("SubtarefaAtribuidoA", fields: [atribuidoAId], references: [id])

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("subtarefas")
}

/// Tabela polimórfica (ADR-004): registra que `usuario` tem acesso a `entidadeId`,
/// que é um Projeto ou uma Tarefa conforme `entidadeTipo`. Sem FK nativa para
/// entidadeId — validação de integridade fica na camada de aplicação.
model Atribuicao {
  id           String       @id @default(cuid())
  usuarioId    String
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entidadeTipo EntidadeTipo
  entidadeId   String

  criadoEm DateTime @default(now())

  @@unique([usuarioId, entidadeTipo, entidadeId])
  @@index([entidadeTipo, entidadeId])
  @@map("atribuicoes")
}

/// Token de uso único para definição de senha (primeiro acesso) e recuperação de
/// senha (RF-030 a RF-032). O e-mail carrega apenas o token em texto puro; só o
/// hash fica no banco.
model TokenAcesso {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  tipo      TipoToken
  expiraEm  DateTime
  usadoEm   DateTime?

  criadoEm DateTime @default(now())

  @@map("tokens_acesso")
}
